{
  "name": "ask-magic-mike",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.26": "8.5.26",
      "sharp@<0.35.0": "0.35.0",
      "esbuild": "0.25.12",
      "vite": "6.4.3",
      "form-data": "4.0.6",
      "js-yaml": "4.3.1",
      "minimatch@3.1.5>brace-expansion": "1.1.18",
      "minimatch@9.0.9>brace-expansion": "2.1.4",
      "minimatch@10.2.5>brace-expansion": "5.0.9"
    }
  },
  "scripts": {
    "dev": "./node_modules/.bin/next dev",
    "build": "./node_modules/.bin/next build",
    "start": "./node_modules/.bin/next start",
    "lint": "eslint .",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "test": "./node_modules/.bin/vitest run",
    "test:watch": "./node_modules/.bin/vitest",
    "test:coverage": "./node_modules/.bin/vitest run --coverage",
    "test:e2e": "./node_modules/.bin/playwright test",
    "test:e2e:ui": "./node_modules/.bin/playwright test --ui",
    "test:all": "./node_modules/.bin/vitest run && ./node_modules/.bin/playwright test",
    "routes:assert": "node scripts/verify-route-manifest.mjs",
    "routes:verify": "node scripts/verify-route-manifest.mjs --build",
    "release:safety": "node scripts/release-safety-scan.mjs",
    "release:doctor": "node scripts/release-doctor.mjs",
    "preview:find": "node scripts/find-vercel-preview.mjs",
    "preview:wait": "node scripts/wait-for-vercel-preview.mjs",
    "preview:qa": "node scripts/preview-qa.mjs",
    "preview:e2e": "./node_modules/.bin/playwright test tests/e2e/widget-preview-flow.spec.ts",
    "release:gate": "pnpm run amm:verify:isolation && pnpm run release:safety && pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run routes:verify",
    "release:report": "node scripts/release-candidate-report.mjs",
    "release:assert": "node scripts/assert-release-candidate.mjs",
    "launch:authority": "node scripts/launch-authority-report.mjs",
    "monitor:synthetic": "node scripts/synthetic-monitor.mjs",
    "monitor-production": "node scripts/monitor-production.mjs",
    "phase9:outcome:cutover": "node scripts/phase9-outcome-production-cutover.mjs",
    "phase9:first-response:cutover": "node scripts/phase9-first-response-production-cutover.mjs",
    "phase9:publication-proof:cutover": "node scripts/phase9-publication-proof-production-cutover.mjs",
    "phase9:wordpress-proof-scope:cutover": "node scripts/phase9-wordpress-proof-scope-production-cutover.mjs",
    "amm:audit:wordpress": "node scripts/audit-wordpress-form-placements.mjs",
    "reconcile-wordpress-leads": "node scripts/reconcile-wordpress-leads.mjs",
    "check-lead-sla": "node scripts/check-lead-sla.mjs",
    "staging:local:up": "node scripts/staging-local-up.mjs",
    "staging:local:verify": "node scripts/staging-local-verify.mjs",
    "staging:local:fixtures": "node scripts/admin-lifecycle-local-fixtures.mjs",
    "staging:local:fixtures:cleanup": "node scripts/admin-lifecycle-local-fixtures.mjs --cleanup",
    "test:postgres:infra02": "node scripts/infra-02-local-db-verify.mjs --postgres-contract",
    "test:supabase:infra02": "node scripts/infra-02-local-db-verify.mjs --supabase-lifecycle",
    "release:pr121:offline": "node scripts/release/pr121-offline-release.mjs",
    "release:preflight": "pnpm run release:doctor && pnpm run release:gate && pnpm run release:report && pnpm run launch:authority",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run routes:verify",
    "smoke:prod": "TARGET_URL=https://www.askmagicmike.com node scripts/prod-smoke.mjs",
    "smoke:target": "node scripts/prod-smoke.mjs",
    "amm:verify:funnel": "node scripts/amm/verify-live-conversion-funnel.mjs",
    "amm:verify:social-preview": "node scripts/amm/verify-social-preview.mjs",
    "amm:smoke:prod": "TARGET_URL=https://www.askmagicmike.com node scripts/prod-smoke.mjs",
    "amm:launch:doctor": "node scripts/amm/launch-readiness-doctor.mjs",
    "amm:launch:authority": "node scripts/amm/launch-authority-report.mjs",
    "amm:public:cta-check": "node scripts/amm/public-cta-final-check.mjs",
    "amm:verify:startup": "node scripts/amm/verify-startup.mjs",
    "amm:verify:health": "node scripts/amm/verify-health.mjs",
    "amm:verify:isolation": "node scripts/amm/verify-system-isolation.mjs",
    "amm:health:lead-pipe": "node scripts/amm/lead-pipe-health-check.mjs",
    "amm:verify:release": "node scripts/amm/verify-release.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.46.1",
    "better-auth": "^1.6.29",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.21",
    "nodemailer": "9.0.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svix": "^1.99.1",
    "tailwind-merge": "^2.5.4",
    "web-push": "3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^15.5.21",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.21",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}

# ─── Canonical PostgreSQL (Neon) ────────────────────────────────────────────
# Server-only pooled connection string. Store as a Sensitive hosting variable.
DATABASE_URL=

# ─── Legacy Supabase compatibility ──────────────────────────────────────────
# SUPERSEDED: retained only for rollback modules. These are not the canonical
# lead/event store and should remain unset on Neon-only Production/Preview apps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Providers ───────────────────────────────────────────────────────────
# Optional. The current public answer route uses OpenAI only when explicitly
# enabled by server configuration; otherwise it returns a bounded safe fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── CRM Adapters ───────────────────────────────────────────────────────────
# Optional. If absent, the null adapter is used (no external CRM writes).
# All CRM calls are logged to crm_sync_log regardless.

# Follow Up Boss
FUB_API_KEY=
FUB_BASE_URL=https://api.followupboss.com/v1

# kvCORE
KVCORE_API_KEY=
KVCORE_BASE_URL=

# ─── Notifications ──────────────────────────────────────────────────────────
# Optional. Used for agent notification emails and SMS.
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# ─── AVM Providers ──────────────────────────────────────────────────────────
# Optional. If absent, mock provider is used (no real valuations).
ATTOM_API_KEY=
HOUSECANARY_API_KEY=
HOUSECANARY_API_SECRET=

# ─── App Configuration ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_NAME=Mike Eatmon
NEXT_PUBLIC_BROKERAGE_NAME=Our Town Properties
# Owner-confirmed live phone only. Leave blank until confirmed; do not restore
# the legacy 252-245-4337 value from historical assets.
NEXT_PUBLIC_AGENT_PHONE=
NEXT_PUBLIC_MARKET_AREA=Wilson, NC
NEXT_PUBLIC_AGENT_LICENSE=

# ─── Admin ──────────────────────────────────────────────────────────────────
# Basic auth secret for /admin routes. Generate in the hosting secret interface.
ADMIN_SECRET=
# Separate server-only signing key for short-lived Brandon phone setup links.
# Generate at least 32 random bytes in the hosting secret interface.
PHONE_SETUP_SIGNING_SECRET=

# ─── SLA Timers (milliseconds) ──────────────────────────────────────────────
SLA_ACCEPT_MS=120000
SLA_CONTACT_MS=300000

# ─── Canonical Lead Platform ────────────────────────────────────────────────
# Canonical public domain. Set to https://www.askmagicmike.com in production.
# The Vercel dashboard must also set www.askmagicmike.com as the Production Domain.
# Vercel alias (ask-magic-mike.vercel.app) is never used as the public brand URL.
NEXT_PUBLIC_SITE_URL=https://www.askmagicmike.com
PUBLIC_SITE_URL=https://www.askmagicmike.com
ADMIN_BASE_URL=https://www.askmagicmike.com/admin

# Public lead capture
LEAD_RATE_LIMIT_PER_MINUTE=10

# Communications provider toggles. When ENABLE_* is false (default), the
# mock adapters log to console + analytics_events but never hit a carrier.
SMS_PROVIDER=mock              # mock | twilio
ENABLE_SMS=false
TWILIO_PHONE_NUMBER=

EMAIL_PROVIDER=mock            # mock | resend | sendgrid
EMAIL_API_KEY=
FROM_EMAIL=
ENABLE_EMAIL=false

# Same-day canonical lead alert contract. Values are entered only through the
# secure hosting/secret interface; never commit real recipients or credentials.
LEAD_NOTIFICATION_TO=mike@ourtownproperties.com
LEAD_NOTIFICATION_BCC=
# Internal staff destinations only, stored as E.164-compatible hosting secrets.
# These do not change the public brokerage phone displayed on either website.
LEAD_SMS_TO=
LEAD_SMS_COPY_TO=
WORDPRESS_BRIDGE_SECRET=
LEAD_SUBJECT_PREFIX=
CONSENT_IP_HASH_SALT=
SMTP_HOST=
SMTP_PORT=587
# true is normally implicit TLS (often port 465); false is normally STARTTLS.
# Match the approved provider instead of guessing from the example file.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Our Town Properties
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
EMAIL_ENABLED=false
# Internal visual-email cards are enabled by default. They contain no lead PII;
# lead facts remain live HTML/text for accessibility and suppression handling.
LEAD_ALERT_VISUALS_ENABLED=true
# When true, attach the static urgency artwork to internal Twilio alerts as MMS.
# Leave false until the sender supports registered MMS and delivery is verified.
LEAD_SMS_MEDIA_ENABLED=false

# Lead notification outbox. Disabled is the safe default: assignment creates
# auditable notification records but does not contact agents or customers.
LEAD_NOTIFICATION_MODE=disabled # disabled | console | sandbox | production
NOTIFICATION_PROVIDER_MODE=disabled
AGENT_NOTIFICATIONS_ENABLED=false
AGENT_SMS_NOTIFICATIONS_ENABLED=false
# Free/open-standard phone alerts. The public VAPID key may be exposed; the
# private key must remain a Sensitive server-only hosting variable.
AGENT_PUSH_NOTIFICATIONS_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mike@ourtownproperties.com
CUSTOMER_EMAIL_ENABLED=false
CUSTOMER_SMS_ENABLED=false
AGENT_NOTIFICATION_FROM_EMAIL=
AGENT_NOTIFICATION_SANDBOX_EMAIL=
AGENT_NOTIFICATION_SANDBOX_ALLOWED_DOMAINS=example.test
LEAD_NOTIFICATION_PRODUCTION_ENABLED=false
CONSOLE_NOTIFICATION_BEHAVIOR=success # success | retryable_failure | permanent_failure

# AI generation toggle. When false (default), MarketingAssetEngine runs
# the deterministic template path; AI-summary endpoints return placeholder.
ENABLE_AI_GENERATION=false

# FlexMLS / IDX
ENABLE_FLEXMLS_API=false
FLEXMLS_CLIENT_ID=
FLEXMLS_CLIENT_SECRET=
FLEXMLS_API_BASE_URL=

# Storage (lead/property photo uploads — not yet wired)
UPLOAD_STORAGE_BUCKET=

# Calendar (scheduling — not yet wired)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Analytics
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# Auth (admin)
AUTH_SECRET=

# SLA cron (called by Vercel Cron / Inngest / external runner)
# When set, /api/admin/sla/sweep also accepts
# `Authorization: Bearer $CRON_SECRET` (in addition to x-admin-secret).
CRON_SECRET=

# Business hours used by SLA notifications (after-hours messaging).
BUSINESS_HOURS_TIMEZONE=America/New_York
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=20:00

# ─── Release-gate database identity ────────────────────────────────────────
# Used by /api/admin/health to decide whether the preview database is
# safe to mutate during QA runs. The health endpoint is the single
# source of truth — preview-qa.mjs refuses to mutate when this resolves
# unsafe, even with FORCE_DB_WRITE.
#
# DATABASE_ENV:                          preview | production | development
# DATABASE_ENV must be explicitly `preview` and VERCEL_ENV must also be
# `preview`; inheriting a preview label from Vercel alone is intentionally
# insufficient because DATABASE_URL could point at production.
# ALLOW_PREVIEW_DB_MUTATION:             explicit opt-in toggle. Must be
#                                        "true" for safe_for_preview_mutation
#                                        to ever return true.
# PREVIEW_DATA_MODE:                     disabled | enabled. Preview
#                                        defaults fail closed unless this is
#                                        "enabled" and mutation opt-in is true.
DATABASE_ENV=
ALLOW_PREVIEW_DB_MUTATION=false
PREVIEW_DATA_MODE=disabled

# ─── Vercel deployment protection bypass (preview QA) ──────────────────────
# When Preview Deployment Protection is enabled, the preview QA runner
# needs to authenticate every request. Set ONE of these (precedence
# top-down). The runner sends the value as the
# `x-vercel-protection-bypass` header — never appended to URLs in
# artifacts. SET_VERCEL_BYPASS_COOKIE=true also sets the cookie header.
VERCEL_AUTOMATION_BYPASS_SECRET=
VERCEL_PROTECTION_BYPASS_TOKEN=
VERCEL_BYPASS_SECRET=
SET_VERCEL_BYPASS_COOKIE=false
